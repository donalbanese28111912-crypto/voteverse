# ─────────────────────────────────────────────────────────────
# Voteverse — environment variables
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://voteverse:voteverse_dev@127.0.0.1:5432/voteverse_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://voteverse:voteverse_dev@127.0.0.1:5432/voteverse_shadow?schema=public"
TEST_DATABASE_URL="postgresql://voteverse:voteverse_dev@127.0.0.1:5432/voteverse_test?schema=public"

# --- API ---
API_PORT=4000
API_URL="http://localhost:4000"
# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:3000"

# --- Auth (JWT) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="900"            # seconds (15 min)
JWT_REFRESH_TTL="2592000"       # seconds (30 days)

# --- Voting / anti-fraud ---
FREE_VOTES_PER_DAY=200
VOTE_RATE_LIMIT_PER_MIN=40

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Monetization is off for the initial public launch. Set to "true" to
# re-enable Voteverse Points purchases and Boost.
FEATURE_BOOST_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Production (Railway API / Vercel web) — see docs/deployment.md
# ─────────────────────────────────────────────────────────────
# PORT is injected by Railway automatically — don't set it yourself.
# CORS_ORIGINS="https://voteverse.global,https://www.voteverse.global,https://voteverse.de,https://www.voteverse.de"
# NEXT_PUBLIC_API_URL="https://api.voteverse.global"
# API_INTERNAL_URL="https://api.voteverse.global"
# NEXT_PUBLIC_SITE_URL="https://voteverse.global"
# NEXT_PUBLIC_FEATURE_BOOST=false
#
# Production seed (structure only, zero fake users/votes):
#   npm run prisma:seed:prod -w @voteverse/api
