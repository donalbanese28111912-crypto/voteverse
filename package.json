{
  "name": "voteverse",
  "version": "0.1.0",
  "private": true,
  "description": "Voteverse — Discover. Vote. Rank. The world's opinion layer.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run -w @voteverse/api prisma:generate",
    "db:migrate": "npm run -w @voteverse/api prisma:migrate",
    "db:seed": "npm run -w @voteverse/api prisma:seed",
    "db:reset": "npm run -w @voteverse/api prisma:reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.17.0",
  "allowScripts": {
    "sharp@0.35.4": true
  }
}
